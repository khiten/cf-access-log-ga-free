# cloudflare-daily-agg 設定ファイル
# このファイルを config.env にコピーして値を埋めてください。
#   cp config.env.example config.env
#   chmod 600 config.env   （APIトークンを含むため、パーミッションを絞ってください）

# Cloudflare APIトークン（Zone > Analytics > Read 権限のみのカスタムトークンを推奨。
# Global API Keyは使わないでください）
CF_API_TOKEN=

# 対象ゾーン名（例: example.com）
CF_ZONE_NAME=

# 出力ファイル名に使う識別子（省略時はCF_ZONE_NAMEを使用）
SITE_NAME=

# ログの保存日数。これより古い data/daily/ 配下の日付フォルダは自動削除されます
RETENTION_DAYS=90

# 何日前を処理対象にするか（1=前日。通常は変更不要）
TARGET_DAYS_AGO=1

# 出力先ディレクトリ（相対パスの場合、このスクリプトからの相対位置）。
# 出力にはアクセス元IP・User-Agent等が含まれるため、Webから直接アクセス
# できない場所（公開ディレクトリ(public_html等)の外）に置いてください
OUTPUT_DIR=./data

# 1回のcron実行での最大処理時間（秒）。ロリポップ等のcron実行時間制限より
# 十分短く設定してください（一般的な共用サーバーの制限は約300秒）。
# run.sh側の多重起動防止ロックは、この値より十分大きい前提で動くので
# 大きく変える場合はrun.sh内のLOCK_STALE_SECONDSも見直してください
MAX_RUNTIME_SECONDS=240

# 1回のcron実行での最大APIクエリ数（レート制限対策の安全弁）
MAX_QUERIES_PER_RUN=200
